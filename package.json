{
  "name": "@aliexme/web-shared",
  "version": "1.0.0",
  "private": true,
  "description": "A set of packages for web development",
  "homepage": "https://github.com/aliexme/web-shared",
  "license": "MIT",
  "author": "Alexander Smirnov <al.smirnov996@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliexme/web-shared"
  },
  "type": "module",
  "scripts": {
    "build": "lerna run build",
    "publish": "lerna publish --no-private",
    "check": "concurrently 'pnpm:check:ts' 'pnpm:check:eslint' 'pnpm:check:stylelint' 'pnpm:check:biome' 'pnpm:check:oxfmt' 'pnpm:check:oxlint'",
    "check:ts": "tsc --noEmit",
    "check:eslint": "eslint ./",
    "check:stylelint": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "check:biome": "biome check",
    "check:prettier": "prettier . --check",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "fix": "concurrently 'pnpm:fix:eslint' 'pnpm:fix:stylelint' 'pnpm:fix:biome' 'pnpm:fix:oxfmt' 'pnpm:fix:oxlint'",
    "fix:eslint": "pnpm run check:eslint --fix",
    "fix:stylelint": "pnpm run check:stylelint --fix",
    "fix:biome": "biome check --write",
    "fix:prettier": "prettier . -l --write",
    "fix:oxfmt": "oxfmt --write",
    "fix:oxlint": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deps": "pnpm run deps:minor && pnpm run deps:patch",
    "deps:patch": "pnx taze patch -r --maturity-period 3 --include-locked -w -i",
    "deps:minor": "pnx taze minor -r --maturity-period 7 --include-locked -w -i",
    "deps:major": "pnx taze major -r --maturity-period 21 --include-locked --interactive -w -i"
  },
  "devDependencies": {
    "@aliexme/biome-config": "workspace:*",
    "@aliexme/eslint-config": "workspace:*",
    "@aliexme/js-utils": "workspace:*",
    "@aliexme/oxfmt-config": "workspace:*",
    "@aliexme/oxlint-config": "workspace:*",
    "@aliexme/prettier-config": "workspace:*",
    "@aliexme/react-utils": "workspace:*",
    "@aliexme/stylelint-config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@eslint-react/eslint-plugin": "5.24.10",
    "@stylistic/eslint-plugin-migrate": "4.4.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.11.1",
    "lefthook": "2.2.2",
    "lerna": "10.1.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
