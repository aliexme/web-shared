{
  "name": "@aliexme/web-shared",
  "version": "1.0.0",
  "private": true,
  "description": "A set of packages for web development",
  "homepage": "https://github.com/aliexme/web-shared",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliexme/web-shared"
  },
  "license": "MIT",
  "author": "Alexander Smirnov <al.smirnov996@gmail.com>",
  "type": "module",
  "scripts": {
    "lerna:build": "lerna run build",
    "lerna:publish": "lerna publish --no-private",
    "ts:check": "tsc --noEmit",
    "eslint:check": "eslint ./",
    "eslint:fix": "pnpm run eslint:check --fix",
    "stylelint:check": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "stylelint:fix": "pnpm run stylelint:check --fix",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "lint:check": "concurrently \"pnpm:ts:check\"  \"pnpm:eslint:check\"  \"pnpm:stylelint:check\" \"pnpm:biome:check\"",
    "jest": "jest",
    "jest:coverage": "jest --collectCoverage",
    "check": "pnpm run lint:check && pnpm run jest",
    "deps:bump:patch": "pnx taze patch -r --maturity-period 3 --include-locked -w -i",
    "deps:bump:minor": "pnx taze minor -r --maturity-period 7 --include-locked -w -i",
    "deps:bump:major": "pnx taze major -r --maturity-period 21 --include-locked --interactive -w -i"
  },
  "devDependencies": {
    "@aliexme/biome-config": "workspace:*",
    "@aliexme/eslint-config": "workspace:*",
    "@aliexme/js-utils": "workspace:*",
    "@aliexme/prettier-config": "workspace:*",
    "@aliexme/react-utils": "workspace:*",
    "@aliexme/stylelint-config": "workspace:*",
    "@aliexme/ts-types": "workspace:*",
    "@biomejs/biome": "2.5.14",
    "@eslint/compat": "2.1.1",
    "@stylistic/eslint-plugin-migrate": "4.4.1",
    "@types/jest": "30.0.0",
    "@types/seedrandom": "3.0.8",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.11.1",
    "jest": "30.5.2",
    "lefthook": "2.1.14",
    "lerna": "10.0.1",
    "prettier": "3.9.9",
    "seedrandom": "3.0.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-dts": "5.1.1",
    "vite-plugin-externalize-deps": "0.10.0"
  }
}
