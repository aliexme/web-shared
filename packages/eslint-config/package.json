{
  "name": "@aliexme/eslint-config",
  "version": "4.1.1",
  "private": false,
  "description": "Rule set for ESLint",
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "homepage": "https://github.com/aliexme/web-shared/tree/main/packages/eslint-config",
  "license": "MIT",
  "author": "Alexander Smirnov <al.smirnov996@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliexme/web-shared",
    "directory": "packages/eslint-config"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "configs"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./stylistic": {
      "types": "./index.d.ts",
      "default": "./configs/stylistic.js"
    },
    "./react": {
      "types": "./index.d.ts",
      "default": "./configs/react.js"
    },
    "./vue": {
      "types": "./index.d.ts",
      "default": "./configs/vue.js"
    },
    "./astro": {
      "types": "./index.d.ts",
      "default": "./configs/astro.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.10.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.0",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-vue": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    }
  }
}
